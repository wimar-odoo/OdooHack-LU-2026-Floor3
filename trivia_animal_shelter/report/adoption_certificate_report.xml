<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TODO 6 - Adoption Certificate Report Action -->
    <record id="action_report_adoption_certificate" model="ir.actions.report">
        <field name="name">Adoption Certificate</field>
        <field name="model">shelter.adoption.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">trivia_animal_shelter.report_adoption_certificate</field>
        <field name="binding_model_id" ref="model_shelter_adoption_request"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Adoption Certificate - %s' % (object.animal_id.name)</field>
    </record>

    <!-- Adoption Certificate PDF Template -->
    <template id="report_adoption_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <div class="page">

                        <div class="text-center mb-5">
                            <h1 style="color: #198754; font-size: 32px;">
                                Adoption Certificate
                            </h1>
                            <p class="text-muted">
                                Refuge Les 4 Pattes
                            </p>
                            <hr style="border: 2px solid #198754;"/>
                        </div>

                        <div class="text-center mb-5">
                            <h2>Congratulations!</h2>
                            <p class="lead">
                                This certificate confirms the adoption request for:
                            </p>

                            <h1 style="font-size: 36px; margin: 30px 0;">
                                <span t-out="o.animal_id.species_emoji"/>
                                <span t-field="o.animal_id.name"/>
                            </h1>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <h4>Applicant Information</h4>
                                <hr/>

                                <p>
                                    <strong>Applicant:</strong>
                                    <span t-field="o.name"/>
                                </p>

                                <p>
                                    <strong>Email:</strong>
                                    <span t-field="o.email"/>
                                </p>

                                <p t-if="o.phone">
                                    <strong>Phone:</strong>
                                    <span t-field="o.phone"/>
                                </p>
                            </div>

                            <div class="col-6">
                                <h4>Animal Information</h4>
                                <hr/>

                                <p>
                                    <strong>Name:</strong>
                                    <span t-field="o.animal_id.name"/>
                                </p>

                                <p>
                                    <strong>Species:</strong>
                                    <span t-out="dict(o.animal_id._fields['species'].selection).get(o.animal_id.species)"/>
                                </p>

                                <p t-if="o.animal_id.breed">
                                    <strong>Breed:</strong>
                                    <span t-field="o.animal_id.breed"/>
                                </p>
                            </div>
                        </div>

                        <div class="text-center mt-5 pt-4">
                            <p>
                                Issued by
                                <strong t-out="res_company.name"/>
                            </p>

                            <p>
                                <strong>Date:</strong>
                                <span t-out="time.strftime('%d/%m/%Y')"/>
                            </p>
                        </div>

                        <div class="text-center mt-5">
                            <p style="font-style: italic; color: #198754;">
                                "Every animal deserves a loving home."
                            </p>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
