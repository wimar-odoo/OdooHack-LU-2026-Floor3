<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TODO 2 - The page /adopt -->
    <template id="animal_list" name="Adopt: Animals">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">

                    <h1>Adopt a friend</h1>
                    <p class="lead">
                        These animals of the Refuge Les 4 Pattes are waiting for a family.
                    </p>

                    <!-- Species filters -->
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <a href="/adopt"
                           t-att-class="'btn btn-primary' if not species else 'btn btn-outline-primary'">
                            All
                        </a>

                        <t t-foreach="species_list" t-as="sp">
                            <a t-att-href="'/adopt?species=%s' % sp[0]"
                               t-att-class="'btn btn-primary' if species == sp[0] else 'btn btn-outline-primary'">
                                <t t-out="sp[1]"/>
                            </a>
                        </t>
                    </div>

                    <!-- Animals grid -->
                    <div class="row g-4">
                        <t t-foreach="animals" t-as="animal">
                            <div class="col-12 col-md-6 col-lg-4">
                                <t t-call="trivia_animal_shelter.animal_card"/>
                            </div>
                        </t>
                    </div>

                    <!-- Empty state -->
                    <t t-if="not animals">
                        <div class="alert alert-info mt-4">
                            No animals are currently available for adoption.
                        </div>
                    </t>

                </div>
            </div>
        </t>
    </template>


    <!-- TODO 2 - Animal card -->
    <template id="animal_card" name="Adopt: Animal Card">
        <div class="card h-100 o_shelter_card"
             t-att-data-animal-id="animal.id">

            <div class="card-body d-flex flex-column">

                <div class="display-4 text-center mb-3"
                     t-out="animal.species_emoji"/>

                <h3 class="card-title text-center">
                    <t t-out="animal.name"/>
                </h3>

                <p class="text-muted text-center mb-3">
                    <t t-if="animal.breed">
                        <t t-out="animal.breed"/>
                    </t>
                    <t t-if="animal.age">
                        · <t t-out="animal.age"/>
                    </t>
                </p>

                <div class="text-center mt-auto">
                    <a t-att-href="animal.website_url"
                       class="btn btn-primary">
                        Meet me!
                    </a>
                </div>

            </div>
        </div>
    </template>


    <!-- TODO 3 - Animal detail page -->
    <!-- TODO 4 - Adoption form -->
    <template id="animal_detail" name="Adopt: Animal">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">

                    <a href="/adopt"
                       class="btn btn-outline-secondary mb-4">
                        ← All the animals
                    </a>

                    <!-- Animal information -->
                    <div class="row g-5">

                        <div class="col-12 col-md-5 text-center">
                            <div class="display-1 mb-3"
                                 t-out="animal.species_emoji"/>
                        </div>

                        <div class="col-12 col-md-7">

                            <h1 t-out="animal.name"/>

                            <p class="lead">
                                <t t-if="animal.breed">
                                    <t t-out="animal.breed"/>
                                </t>
                            </p>

                            <ul class="list-unstyled">

                                <li t-if="animal.age" class="mb-2">
                                    <strong>Age:</strong>
                                    <t t-out="animal.age"/>
                                </li>

                                <li t-if="animal.sex" class="mb-2">
                                    <strong>Sex:</strong>
                                    <t t-out="dict(animal._fields['sex'].selection).get(animal.sex)"/>
                                </li>

                                <li class="mb-2">
                                    <strong>Species:</strong>
                                    <t t-out="dict(animal._fields['species'].selection).get(animal.species)"/>
                                </li>

                            </ul>

                            <div class="mt-4">
                                <p t-if="animal.description"
                                   t-out="animal.description"/>
                            </div>

                        </div>
                    </div>


                    <!-- Adoption form -->
                    <div class="row mt-5">
                        <div class="col-12 col-lg-8 offset-lg-2">

                            <div class="card shadow-sm">
                                <div class="card-body p-4">

                                    <h2>Interested in adopting?</h2>

                                    <p>
                                        Fill in the form below and we will contact you.
                                    </p>

                                    <form method="POST"
                                          t-att-action="animal.website_url + '/request'">

                                        <input type="hidden"
                                               name="csrf_token"
                                               t-att-value="request.csrf_token()"/>

                                        <div class="mb-3">
                                            <label class="form-label"
                                                   for="name">
                                                Your name
                                            </label>

                                            <input type="text"
                                                   id="name"
                                                   name="name"
                                                   class="form-control"
                                                   required="required"/>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label"
                                                   for="email">
                                                Email
                                            </label>

                                            <input type="email"
                                                   id="email"
                                                   name="email"
                                                   class="form-control"
                                                   required="required"/>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label"
                                                   for="phone">
                                                Phone
                                            </label>

                                            <input type="tel"
                                                   id="phone"
                                                   name="phone"
                                                   class="form-control"/>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label"
                                                   for="message">
                                                Message
                                            </label>

                                            <textarea id="message"
                                                      name="message"
                                                      class="form-control"
                                                      rows="4"/>
                                        </div>

                                        <button type="submit"
                                                class="btn btn-primary">
                                            Send adoption request
                                        </button>

                                    </form>

                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>


    <!-- Adoption thank you page -->
    <template id="adoption_thanks" name="Adopt: Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5 text-center">

                    <div class="display-1"
                         t-out="animal.species_emoji"/>

                    <h1>
                        Thank you
                        <t t-out="adoption_request.name"/>!
                    </h1>

                    <p class="lead">
                        Your request to adopt
                        <b t-out="animal.name"/>
                        has been sent to the shelter.
                        We will contact you very soon.
                    </p>

                    <a href="/adopt" class="btn btn-primary">
                        See the other animals
                    </a>

                </div>
            </div>
        </t>
    </template>


    <!-- TODO 5 - Website menu -->
    <record id="website_menu_adopt" model="website.menu">
        <field name="name">Adopt</field>
        <field name="url">/adopt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">50</field>
    </record>

    <!-- TODO 5 - Website menu -->
    <!-- To be configured separately in XML data or through the website menu -->


    <!-- BONUS - Animal of the week snippet -->
    <!-- To be implemented separately -->

</odoo>
