<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         TODO 2 - The page /adopt
         Variables given by the controller:
           * animals: the animals to display
           * species: the species of the filter (e.g. 'cat'), or False
         ====================================================================== -->
    <template id="animal_list" name="Adopt: Animals">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <h1>Adopt a friend</h1>
                    <p class="lead">These animals of the Refuge Les 4 Pattes are waiting for a family.</p>
                    <div class="o_shelter_filters d-flex flex-wrap gap-2 mb-4">
                        <a href="/adopt" t-attf-class="btn rounded-pill #{'btn-primary' if not species else 'btn-outline-primary'}">All</a>
                        <t t-foreach="request.env['shelter.animal']._get_species()" t-as="species_option">
                            <a t-attf-href="/adopt?species=#{species_option[0]}"
                               t-attf-class="btn rounded-pill #{'btn-primary' if species == species_option[0] else 'btn-outline-primary'}"
                               t-out="species_option[1]"/>
                        </t>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        <div t-foreach="animals" t-as="animal" class="col">
                            <t t-call="trivia_animal_shelter.animal_card"/>
                        </div>
                    </div>
                    <div t-if="not animals" class="alert alert-info mt-4">
                        No animal is waiting for a family here right now. Come back soon!
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ======================================================================
         TODO 2 - The card of an animal (variable: animal)
         ====================================================================== -->
    <template id="animal_card" name="Adopt: Animal Card">
        <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id">
            <div class="o_shelter_card_emoji card-img-top text-center" t-out="animal.species_emoji"/>
            <div class="card-body">
                <h5 class="card-title mb-1" t-out="animal.name"/>
                <p class="card-text text-muted mb-0">
                    <span t-if="animal.breed" t-out="animal.breed"/>
                    <t t-if="animal.breed and animal.age"> · </t>
                    <span t-if="animal.age" t-out="animal.age"/>
                </p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a t-att-href="animal.website_url" class="btn btn-primary stretched-link">Meet <t t-out="animal.name"/></a>
            </div>
        </div>
    </template>

    <!-- ======================================================================
         TODO 3 - The page of an animal (variable: animal)
         TODO 4 - The adoption form, on the same page
         ====================================================================== -->
    <template id="animal_detail" name="Adopt: Animal">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <a href="/adopt">← All the animals</a>
                    <div class="row g-5 mt-1">
                        <div class="col-12 col-lg-6">
                            <div class="o_shelter_detail_emoji text-center mb-3" t-out="animal.species_emoji"/>
                            <h1 t-field="animal.name"/>
                            <dl class="row">
                                <t t-if="animal.breed">
                                    <dt class="col-4">Breed</dt>
                                    <dd class="col-8"><span t-field="animal.breed"/></dd>
                                </t>
                                <t t-if="animal.age">
                                    <dt class="col-4">Age</dt>
                                    <dd class="col-8" t-out="animal.age"/>
                                </t>
                                <t t-if="animal.sex">
                                    <dt class="col-4">Sex</dt>
                                    <dd class="col-8"><span t-field="animal.sex"/></dd>
                                </t>
                            </dl>
                            <p class="lead" t-field="animal.description"/>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <h2 class="h4">Adopt <t t-out="animal.name"/></h2>
                                    <form t-attf-action="#{animal.website_url}/request" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_name">Your name</label>
                                            <input type="text" class="form-control" id="shelter_name" name="name" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_email">Email</label>
                                            <input type="email" class="form-control" id="shelter_email" name="email" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_phone">Phone</label>
                                            <input type="tel" class="form-control" id="shelter_phone" name="phone"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_message">Message</label>
                                            <textarea class="form-control" id="shelter_message" name="message" rows="4"
                                                      placeholder="Tell us about your home and your family"/>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100">Send my adoption request</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- The page displayed after an adoption request (variables: animal, adoption_request) -->
    <template id="adoption_thanks" name="Adopt: Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5 text-center">
                    <div class="display-1" t-out="animal.species_emoji"/>
                    <h1>Thank you <t t-out="adoption_request.name"/>!</h1>
                    <p class="lead">
                        Your request to adopt <b t-out="animal.name"/> has been sent to the shelter.
                        We will contact you very soon.
                    </p>
                    <a href="/adopt" class="btn btn-primary">See the other animals</a>
                </div>
            </div>
        </t>
    </template>

    <!-- TODO 5: a menu "Adopt" in the main menu of the website, opening /adopt -->
    <record id="menu_adopt" model="website.menu">
        <field name="name">Adopt</field>
        <field name="url">/adopt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">30</field>
    </record>

    <!-- ⭐ BONUS: a building block (snippet) "Animal of the week", available in the website editor -->
    <template id="s_animal_of_the_week" name="Animal of the week">
        <section class="s_animal_of_the_week o_shelter_snippet py-5">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-md-4 text-center">
                        <div class="o_shelter_detail_emoji">🐾</div>
                    </div>
                    <div class="col-12 col-md-8">
                        <span class="badge rounded-pill text-bg-primary mb-2">Animal of the week</span>
                        <h2>Meet our animal of the week</h2>
                        <p class="lead">A gentle friend of the Refuge Les 4 Pattes is waiting for a family. Write a few
                            words about them here!</p>
                        <a href="/adopt" class="btn btn-primary">Adopt a friend</a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Shelter Snippets">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="trivia_animal_shelter.s_animal_of_the_week" string="Animal of the week" group="content">
                <keywords>animal, pet, adopt, shelter, week</keywords>
            </t>
        </xpath>
    </template>
</odoo>
