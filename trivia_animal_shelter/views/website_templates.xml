<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mission 5: Website Menu -->
    <record id="menu_adopt" model="website.menu">
        <field name="name">Adopt</field>
        <field name="url">/adopt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">50</field>
    </record>

    <!-- Mission 2: Card of an animal -->
    <template id="animal_card" name="Animal Card">
        <div class="card o_shelter_card h-100" t-att-data-animal-id="animal.id">
            <div class="card-body d-flex flex-column">
                <div class="display-4 mb-2" t-out="animal.species_emoji"/>
                <h5 class="card-title" t-out="animal.name"/>
                <p class="card-text text-muted mb-1" t-out="animal.breed"/>
                <p class="card-text small mb-3" t-out="animal.age"/>
                <a t-att-href="animal.website_url" class="btn btn-primary mt-auto">
                    Adopt <t t-out="animal.name"/>
                </a>
            </div>
        </div>
    </template>

    <!-- Mission 2 & Bonus 1: /adopt Page -->
    <template id="animal_list" name="Adoptable Animals">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <h1 class="mb-4 text-center">Adoptable Animals</h1>

                    <!-- Bonus 1: Filter buttons by species -->
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <a href="/adopt"
                           t-attf-class="btn #{not current_species and 'btn-primary' or 'btn-outline-primary'}">
                            All
                        </a>
                        <t t-foreach="species_selection or []" t-as="sp">
                            <a t-attf-href="/adopt?species=#{sp[0]}"
                               t-attf-class="btn #{current_species == sp[0] and 'btn-primary' or 'btn-outline-primary'}">
                                <t t-out="sp[1]"/>
                            </a>
                        </t>
                    </div>

                    <!-- Responsive Bootstrap Grid -->
                    <div class="row g-4">
                        <t t-foreach="animals" t-as="animal">
                            <div class="col-12 col-md-6 col-lg-4">
                                <t t-call="trivia_animal_shelter.animal_card"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Mission 3 & 4: Animal Detail Page & Adoption Form -->
    <template id="animal_detail" name="Animal Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="mb-3">
                        <a href="/adopt" class="btn btn-link px-0">&amp;larr; Back to adoptable animals</a>
                    </div>

                    <div t-if="submitted" class="alert alert-success" role="alert">
                        Your adoption request has been submitted!
                    </div>

                    <div class="row g-5">
                        <div class="col-12 col-md-6">
                            <h1>
                                <span t-field="animal.species_emoji"/>
                                <span t-field="animal.name"/>
                            </h1>
                            <p class="text-muted">
                                <strong>Breed:</strong> <span t-field="animal.breed"/> |
                                <strong>Age:</strong> <span t-field="animal.age"/>
                            </p>
                            <div class="mt-3" t-field="animal.description"/>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="card p-4 shadow-sm">
                                <h3 class="mb-3">Request to Adopt</h3>
                                <form method="post" t-attf-action="#{animal.website_url}/request">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label class="form-label" for="name">Your Name</label>
                                        <input type="text" class="form-control" name="name" id="name" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="email">Email</label>
                                        <input type="email" class="form-control" name="email" id="email" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="phone">Phone</label>
                                        <input type="tel" class="form-control" name="phone" id="phone"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="message">Message</label>
                                        <textarea class="form-control" name="message" id="message" rows="4"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Send Request</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Bonus 2: Animal of the Week Building Block -->
    <template id="s_animal_of_the_week" name="Animal of the Week">
        <section class="s_animal_of_the_week py-5 bg-light">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <span class="badge text-bg-warning mb-2">Animal of the Week</span>
                        <h2>Meet Our Star Resident!</h2>
                        <p class="lead">Give a loving home to our featured shelter companion of the week.</p>
                        <a href="/adopt" class="btn btn-primary">Meet the Animals</a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="(//t[@t-snippet])[1]" position="after">
            <t t-snippet="trivia_animal_shelter.s_animal_of_the_week"
               string="Animal of the Week"
               t-thumbnail="/trivia_animal_shelter/static/description/icon.png"/>
        </xpath>
    </template>
</odoo>