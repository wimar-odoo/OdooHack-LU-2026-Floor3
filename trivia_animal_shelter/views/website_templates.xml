<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         TODO 2 - The page /adopt
         Variables given by the controller:
           * animals: the animals to display
           * species: the species of the filter (e.g. 'cat'), or False
         ====================================================================== -->
    <template id="animal_list" name="Adopt: Animals">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <h1>Adopt a friend</h1>
                    <p class="lead">These animals of the Refuge Les 4 Pattes are waiting for a family.</p>
                    <!-- Filter buttons (Species + Sex) & Sort dropdown -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <div class="btn-group" role="group" aria-label="Species Filter">
                                <a t-attf-href="/adopt#{('?sex=' + sex) if sex else ''}"
                                   t-attf-class="btn #{'btn-primary' if not species else 'btn-outline-primary'}">
                                    All Species
                                </a>
                                <t t-foreach="request.env['shelter.animal']._get_species()" t-as="spec">
                                    <a name="species"
                                       t-attf-href="/adopt?species=#{spec[0]}#{('&amp;sex=' + sex) if sex else ''}#{('&amp;sort_by=' + sort_by) if sort_by else ''}"
                                       t-attf-class="btn #{'btn-primary' if species == spec[0] else 'btn-outline-primary'}"
                                       t-out="spec[1]"/>
                                </t>
                            </div>

                            <!-- Sex Filter -->
                            <div class="btn-group" role="group" aria-label="Sex Filter">
                                <a t-attf-href="/adopt?#{('&amp;species=' + species) if species else ''}#{('&amp;sort_by=' + sort_by) if sort_by else ''}"
                                   t-attf-class="btn #{'btn-secondary' if not sex else 'btn-outline-secondary'}">
                                    All Sexes
                                </a>
                                <t t-foreach="request.env['shelter.animal']._get_sexes()" t-as="s">
                                    <a t-attf-href="/adopt?sex=#{s[0]}#{('&amp;species=' + species) if species else ''}#{('&amp;sort_by=' + sort_by) if sort_by else ''}"
                                       t-attf-class="btn #{'btn-secondary' if sex == s[0] else 'btn-outline-secondary'}"
                                       t-out="s[1]"/>
                                </t>
                            </div>
                        </div>

                        <!-- Sort dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-sort me-1"/> Sort by
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" t-attf-href="/adopt?sort_by=name#{('&amp;species=' + species) if species else ''}#{('&amp;sex=' + sex) if sex else ''}">Name (A-Z)</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" t-attf-href="/adopt?sort_by=youngest#{('&amp;species=' + species) if species else ''}#{('&amp;sex=' + sex) if sex else ''}">Youngest first</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" t-attf-href="/adopt?sort_by=oldest#{('&amp;species=' + species) if species else ''}#{('&amp;sex=' + sex) if sex else ''}">Oldest first</a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Responsive grid: 1 card per row on mobile (col-12), 2 on tablet (col-md-6), 3 on desktop (col-lg-4) -->
                    <div class="row g-4">
                        <t t-foreach="animals" t-as="animal">
                            <div class="col-12 col-md-6 col-lg-4">
                                <t t-call="trivia_animal_shelter.animal_card"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ======================================================================
         TODO 2 - The card of an animal (variable: animal)
         The root element must be EXACTLY:
             <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id"> ... </div>
         It shows the emoji of the species (animal.species_emoji), the name, the breed, the age,
         and a link to the page of the animal (animal.website_url).
         ====================================================================== -->
    <template id="animal_card" name="Adopt: Animal Card">
        <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id">
            <div class="card-body d-flex flex-column text-center">
                <div class="display-3 mb-2" t-out="animal.species_emoji"/>
                <h5 class="card-title fw-bold" t-out="animal.name"/>
                <p class="card-text text-muted mb-1" t-if="animal.breed">
                    <t t-out="animal.breed"/>
                </p>
                <p class="card-text text-muted mb-3" t-if="animal.age">
                    <t t-out="animal.age"/>
                </p>
                <a t-att-href="animal.website_url" class="btn btn-outline-primary mt-auto">
                    Meet <t t-out="animal.name"/>
                </a>
            </div>
        </div>
    </template>

    <!-- ======================================================================
         TODO 3 - The page of an animal (variable: animal)
         It shows the emoji of the species, the name, the breed, the age, the sex and the description.

         TODO 4 - The adoption form, on the same page: the fields name, email, phone and message,
         posted (method POST) to the URL of the animal followed by /request.
         Don't forget the CSRF token of the form!
         ====================================================================== -->
    <template id="animal_detail" name="Adopt: Animal">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <div class="mb-4">
                        <a href="/adopt" class="text-decoration-none">← All the animals</a>
                    </div>
                    <div class="row g-5">
                        <div class="col-12 col-md-5 text-center">
                            <div class="card p-4 border-0 shadow-sm bg-light">
                                <div class="display-1 mb-3" t-out="animal.species_emoji"/>
                                <h2 class="fw-bold" t-out="animal.name"/>
                                <p class="lead text-muted mb-2" t-if="animal.breed" t-out="animal.breed"/>
                                <div class="d-flex justify-content-center gap-2 mt-2">
                                    <span class="badge bg-secondary px-3 py-2" t-if="animal.age" t-out="animal.age"/>
                                    <span class="badge bg-info text-dark px-3 py-2 text-capitalize" t-if="animal.sex" t-out="animal.sex"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-7">
                            <h3 class="fw-bold mb-3">About <t t-out="animal.name"/></h3>
                            <div class="mb-4 text-secondary" style="white-space: pre-line;" t-out="animal.description"/>

                            <div class="card p-4 border mt-4 shadow-sm">
                                <h4 class="card-title mb-3">Ask to adopt <t t-out="animal.name"/></h4>
                                <form method="post" t-attf-action="#{animal.website_url}/request">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label for="name" class="form-label">Your Name</label>
                                        <input type="text" id="name" name="name" class="form-control" required="required" placeholder="Jane Doe"/>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="email" class="form-label">Email Address</label>
                                            <input type="email" id="email" name="email" class="form-control" required="required" placeholder="jane@example.com"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="phone" class="form-label">Phone Number</label>
                                            <input type="tel" id="phone" name="phone" class="form-control" placeholder="+352 ..."/>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="message" class="form-label">Message</label>
                                        <textarea id="message" name="message" class="form-control" rows="4" placeholder="Tell us why you would love to adopt..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        Send Adoption Request
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- The page displayed after an adoption request (variables: animal, adoption_request) -->
    <template id="adoption_thanks" name="Adopt: Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5 text-center">
                    <div class="display-1" t-out="animal.species_emoji"/>
                    <h1>Thank you <t t-out="adoption_request.name"/>!</h1>
                    <p class="lead">
                        Your request to adopt <b t-out="animal.name"/> has been sent to the shelter.
                        We will contact you very soon.
                    </p>
                    <a href="/adopt" class="btn btn-primary">See the other animals</a>
                </div>
            </div>
        </t>
    </template>

    <!-- TODO 5: a menu "Adopt" in the main menu of the website, opening /adopt (model website.menu) -->
    <record id="menu_adopt" model="website.menu">
        <field name="name">Adopt</field>
        <field name="url">/adopt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">50</field>
    </record>

    <template id="s_animal_of_the_week" name="Animal of the week">
        <section class="s_animal_of_the_week py-5 bg-light text-center">
            <div class="container">
                <span class="badge bg-warning text-dark px-3 py-2 fs-6 mb-3">⭐ Star of the Week</span>
                <h2 class="display-5 fw-bold mb-3">Meet Our Animal of the Week!</h2>
                <div class="display-1 mb-3">🐶</div>
                <h3 class="fw-bold">Bella</h3>
                <p class="lead text-muted mx-auto" style="max-width: 600px;">
                    Friendly, energetic, and loves cuddles! Ready to join a caring family.
                </p>
                <a href="/adopt" class="btn btn-primary btn-lg mt-3">Adopt a Pet</a>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Shelter Snippets">
        <xpath expr="//t[@t-snippet][1]" position="before">
            <t t-snippet="trivia_animal_shelter.s_animal_of_the_week"
               string="Animal of the week"
               group="content"
               t-thumbnail="/trivia_animal_shelter/static/description/icon.png"/>
        </xpath>
    </template>

</odoo>
