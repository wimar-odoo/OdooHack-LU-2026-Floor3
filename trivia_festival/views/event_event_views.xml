<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_inherit_festival" model="ir.ui.view">
        <field name="name">event.event.form.inherit.festival</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='seats_limited']" position="before">
                <!-- TODO 1: display this field with your widget festival_fill_gauge -->
                <field name="seats_taken" string="Fill Rate" widget="festival_fill_gauge"/>
            </xpath>
        </field>
    </record>
</odoo>
