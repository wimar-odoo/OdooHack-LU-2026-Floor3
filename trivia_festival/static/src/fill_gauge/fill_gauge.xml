<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="trivia_festival.FillGauge">
        <div class="d-flex flex-column">
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="this.percentage">
                <div class="progress-bar" t-att-class="this.color" t-att-style="this.progressStyle"/>
            </div>
            <span class="mt-1">
                <t t-out="this.value"/> / <t t-out="this.max"/> (<t t-out="this.percentage"/>%)
            </span>
        </div>
    </t>

</templates>
