<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    TODO 5 - The members on the contacts

    * the contact form (base.view_partner_form) gets a "Membership" page, with the fields
      membership_type, member_since, last_paid_year and the list of the fees (fee_ids);
    * the contacts get a filter "Not up to date": the members whose last paid year is before
      the current year.

    ⭐ BONUS: a "Fees" smart button on the contact form, showing the number of fees of the member.
    -->

    <record id="view_partner_form_membership" model="ir.ui.view">
        <field name="name">res.partner.form.membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Membership" name="membership">
                    <group>
                        <group>
                            <field name="membership_type"/>
                            <field name="member_since"/>
                        </group>
                        <group>
                            <field name="last_paid_year"/>
                        </group>
                    </group>
                    <field name="fee_ids">
                        <list>
                            <field name="year"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="payment_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
