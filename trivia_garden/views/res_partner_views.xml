<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact form: "Membership" page + "Fees" smart button -->
    <record id="res_partner_view_form_garden" model="ir.ui.view">
        <field name="name">res.partner.form.garden</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fees" type="object" class="oe_stat_button" icon="fa-money">
                    <field name="fee_count" widget="statinfo" string="Fees"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Membership" name="membership">
                    <group>
                        <group>
                            <field name="membership_type"/>
                            <field name="member_since"/>
                        </group>
                        <group>
                            <field name="last_paid_year"/>
                        </group>
                    </group>
                    <field name="fee_ids">
                        <list>
                            <field name="year"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="payment_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Contact search: "Not up to date" filter -->
    <record id="res_partner_view_search_garden" model="ir.ui.view">
        <field name="name">res.partner.search.garden</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Not up to date" name="not_up_to_date"
                        domain="[('last_paid_year', '&lt;', context_today().year)]"/>
            </xpath>
        </field>
    </record>
</odoo>