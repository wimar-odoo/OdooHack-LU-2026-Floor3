<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garden_plot_view_list" model="ir.ui.view">
        <field name="name">garden.plot.list</field>
        <field name="model">garden.plot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="site_id"/>
                <field name="area"/>
                <field name="tenant_id"/>
            </list>
        </field>
    </record>

    <record id="garden_plot_view_form" model="ir.ui.view">
        <field name="name">garden.plot.form</field>
        <field name="model">garden.plot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. B-07"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="area"/>
                        </group>
                        <group>
                            <field name="tenant_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garden_plot_view_search" model="ir.ui.view">
        <field name="name">garden.plot.search</field>
        <field name="model">garden.plot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenant_id"/>
                <filter name="free" string="Free" domain="[('tenant_id', '=', False)]"/>
                <filter name="rented" string="Rented" domain="[('tenant_id', '!=', False)]"/>
                <filter name="group_by_site" string="Site" context="{'group_by': 'site_id'}"/>
            </search>
        </field>
    </record>

    <record id="garden_plot_view_kanban" model="ir.ui.view">
        <field name="name">garden.plot.kanban</field>
        <field name="model">garden.plot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="site_id">
                <field name="name"/>
                <field name="site_id"/>
                <field name="area"/>
                <field name="tenant_id"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="tenant_id"/>
                        <field name="area"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="garden_plot_action" model="ir.actions.act_window">
        <field name="name">Plots</field>
        <field name="res_model">garden.plot</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>